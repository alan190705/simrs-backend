generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tahap 1: fondasi identitas, cabang, dan audit. Tabel klinis dirancang lewat ERD sebelum Tahap 4.

model Branch {
  id           String       @id @default(uuid(7)) @db.Uuid
  code         String       @unique
  name         String
  address      String?
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  userRoles    UserRole[]
  userBranches UserBranch[]
  auditLogs    AuditLog[]

  @@map("branches")
}

model User {
  id            String             @id @default(uuid(7)) @db.Uuid
  username      String             @unique
  email         String?            @unique
  fullName      String             @map("full_name")
  passwordHash  String             @map("password_hash")
  isActive      Boolean            @default(true) @map("is_active")
  lastLoginAt   DateTime?          @map("last_login_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")
  roles         UserRole[]
  branches      UserBranch[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  moduleAccess  UserModuleAccess[]

  @@map("users")
}

model Role {
  id                String                 @id @default(uuid(7)) @db.Uuid
  code              String                 @unique
  name              String
  description       String?
  isSystem          Boolean                @default(false) @map("is_system")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  users             UserRole[]
  permissions       RolePermission[]
  modulePermissions RoleModulePermission[]

  @@map("roles")
}

model Permission {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  moduleId           String                 @map("module_id") @db.Uuid
  code               String // "view", "create", "update", "delete"
  name               String // "Lihat", "Buat", "Ubah", "Hapus"
  description        String?
  createdAt          DateTime               @default(now()) @map("created_at")
  module             Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  roleMappings       RoleModulePermission[]
  userModuleAccesses UserModuleAccess[]
  rolePermissions    RolePermission[]

  @@unique([moduleId, code])
  @@index([moduleId])
  @@map("permissions")
}

// ============================================================
// MODULE & ACCESS CONTROL
// User → Role → Module → Permission
// ============================================================

model Module {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique // "dokter", "farmasi"
  name        String // "Dokter", "Farmasi"
  description String?
  group       String? // "Pelayanan", "Penunjang"
  icon        String? // "Stethoscope"
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions  Permission[]
  roleMappings RoleModulePermission[]
  userMappings UserModuleAccess[]

  @@index([group, order])
  @@map("modules")
}

// Default permission per role
model RoleModulePermission {
  id           String     @id @default(uuid(7)) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  moduleId     String     @map("module_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId, permissionId])
  @@index([roleId])
  @@map("role_module_permissions")
}

// Override per user (grant / deny)
model UserModuleAccess {
  id           String     @id @default(uuid(7)) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  moduleId     String     @map("module_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, permissionId])
  @@index([userId])
  @@map("user_module_access")
}

// branchId NULL = role berlaku di semua cabang. NULL tidak dianggap sama oleh UNIQUE di PostgreSQL,
// jadi duplikasi (user, role, NULL) dicegah di service.
model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserBranch {
  userId    String  @map("user_id") @db.Uuid
  branchId  String  @map("branch_id") @db.Uuid
  isDefault Boolean @default(false) @map("is_default")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  action    String
  module    String
  recordId  String?  @map("record_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([module, recordId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
